# ============================================================
# teradata-gcfr-mcp-server — environment configuration
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ============================================================

# ------------------------------------------------------------
# Teradata connection  (REQUIRED)
# Format: teradata://username:password@host:1025/default_database
# ------------------------------------------------------------
DATABASE_URI=teradata://dbc:dbc@192.168.1.198:1025/GDEV1V_GCFR

# Authentication mechanism: TD2 (default) | LDAP | TDNEGO | KRB5
LOGMECH=TD2

# Connection pool settings
TD_POOL_SIZE=5         # Persistent connections in pool
TD_MAX_OVERFLOW=10     # Extra connections allowed under burst load
TD_POOL_TIMEOUT=30     # Seconds to wait for a free connection

# ------------------------------------------------------------
# GCFR database names
# These default to the GDEV1 environment — override for other environments.
# IMPORTANT: use the V (view) layer databases, NOT the T (table) databases.
# ------------------------------------------------------------
GCFR_VIEW_DB=GDEV1V_GCFR      # Base view layer (registration/metadata tools)
GCFR_OPR_DB=GDEV1V_OPR        # Operational reporting views (GCFR_RV_*)
GCFR_UTLFW_DB=GDEV1V_UTLFW    # BKEY/BMAP views
GCFR_TABLE_DB=GDEV1T_GCFR     # Physical tables — health-check only

# Query behaviour
GCFR_MAX_ROWS=500        # Maximum rows returned by any single tool call
GCFR_QUERY_TIMEOUT=120   # Per-query timeout in seconds

# ------------------------------------------------------------
# MCP transport
# stdio            — for Claude Desktop / Claude Code (default)
# streamable-http  — for web dashboards / REST clients
# sse              — for VS Code / GitHub Copilot
# ------------------------------------------------------------
MCP_TRANSPORT=stdio

# Host and port used by streamable-http and sse transports only
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp/

# ------------------------------------------------------------
# Profiles  (all | ops | performance | lineage)
# Controls which subset of tools is exposed to the MCP client.
# ------------------------------------------------------------
PROFILE=all

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOGGING_LEVEL=WARNING

# Directory scanned for *_tools.yml custom tool definitions
# Defaults to the current working directory.
CONFIG_DIR=.
